<?xml version="1.0"?>
<!-- Tall RoboBoat-style marker buoy (green). Link origin = waterline.
     Buoyancy + drag handled by VRX PolyhedraBuoyancyDrag, so it bobs in waves. -->
<sdf version="1.10">
  <model name="rb_marker_green">
    <link name="link">
      <inertial>
        <pose>0 0 -0.15 0 0 0</pose>
        <mass>6</mass>
        <inertia><ixx>0.53</ixx><iyy>0.53</iyy><izz>0.07</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="visual">
        <pose>0 0 0.3 0 0 0</pose>
        <geometry><cylinder><radius>0.15</radius><length>1.0</length></cylinder></geometry>
        <material><ambient>0.05 0.6 0.1 1</ambient><diffuse>0.05 0.6 0.1 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
      </visual>
      <collision name="collision">
        <pose>0 0 0.3 0 0 0</pose>
        <geometry><cylinder><radius>0.15</radius><length>1.0</length></cylinder></geometry>
      </collision>
    </link>
    <plugin name="vrx::PolyhedraBuoyancyDrag" filename="libPolyhedraBuoyancyDrag.so">
      <fluid_density>1000</fluid_density>
      <fluid_level>0.0</fluid_level>
      <linear_drag>25.0</linear_drag>
      <angular_drag>5.0</angular_drag>
      <buoyancy name="buoyancy_volume">
        <link_name>link</link_name>
        <pose>0 0 0 0 0 0</pose>
        <geometry><cylinder><radius>0.15</radius><length>0.4</length></cylinder></geometry>
      </buoyancy>
      <wavefield><topic>/vrx/wavefield/parameters</topic></wavefield>
    </plugin>
  </model>
</sdf>
