          <upper>1.5708</upper>
        </limit>
      </axis>
    </joint>
    <link name="right_prop_link">
      <pose>-0.76 -0.33 -0.17 0 0 0</pose>
      <inertial>
        <mass>0.105</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="propeller">
        <pose>0 0 0 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>0.045</radius>
            <length>0.01</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
    </link>
    <joint name="right_prop_joint" type="revolute">
      <parent>right_engine_link</parent>
      <child>right_prop_link</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
      </axis>
    </joint>
    <!-- buoyancy of the left hull (VRX): 4 keel points, reacts to the waves -->
    <plugin filename="libSurface.so" name="vrx::Surface">
      <link_name>base_link</link_name>
      <hull_length>1.6</hull_length>
      <hull_radius>0.11</hull_radius>
      <fluid_level>0</fluid_level>
      <points>
        <point>-0.6 0.33 -0.11</point>
        <point>-0.2 0.33 -0.11</point>
        <point>0.2 0.33 -0.11</point>
        <point>0.6 0.33 -0.11</point>
      </points>
      <wavefield>
        <topic>/vrx/wavefield/parameters</topic>
      </wavefield>
    </plugin>
    <!-- buoyancy of the right hull (VRX): 4 keel points, reacts to the waves -->
    <plugin filename="libSurface.so" name="vrx::Surface">
      <link_name>base_link</link_name>
      <hull_length>1.6</hull_length>
      <hull_radius>0.11</hull_radius>
      <fluid_level>0</fluid_level>
      <points>
        <point>-0.6 -0.33 -0.11</point>
        <point>-0.2 -0.33 -0.11</point>
        <point>0.2 -0.33 -0.11</point>
        <point>0.6 -0.33 -0.11</point>
      </points>
      <wavefield>
        <topic>/vrx/wavefield/parameters</topic>
      </wavefield>
    </plugin>
    <!-- water drag (VRX): linear + quadratic damping per axis, uncalibrated -->
    <plugin filename="libSimpleHydrodynamics.so" name="vrx::SimpleHydrodynamics">
      <link_name>base_link</link_name>
      <xDotU>0</xDotU>
      <yDotV>0</yDotV>
      <nDotR>0</nDotR>
      <xU>4</xU>
      <xUU>6</xUU>
      <yV>4</yV>
      <yVV>4</yVV>
      <zW>20</zW>
      <kP>12</kP>
      <kPP>24</kPP>
      <mQ>36</mQ>
      <mQQ>35</mQQ>
      <nR>32</nR>
      <nRR>32</nRR>
    </plugin>
    <!-- left: thrust [N] on /asv/thrusters/left/thrust, steering angle [rad] on /asv/thrusters/left/pos (gz.msgs.Double) -->
    <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
      <namespace>asv</namespace>
      <topic>thrusters/left/thrust</topic>
      <joint_name>left_prop_joint</joint_name>
      <thrust_coefficient>0.004422</thrust_coefficient>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.09</propeller_diameter>
      <velocity_control>true</velocity_control>
      <max_thrust_cmd>50</max_thrust_cmd>
      <min_thrust_cmd>-40</min_thrust_cmd>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>left_steer_joint</joint_name>
      <topic>/asv/thrusters/left/pos</topic>
      <use_velocity_commands>true</use_velocity_commands>
      <cmd_max>2</cmd_max>
      <cmd_min>-2</cmd_min>
    </plugin>
    <!-- right: thrust [N] on /asv/thrusters/right/thrust, steering angle [rad] on /asv/thrusters/right/pos (gz.msgs.Double) -->
    <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
      <namespace>asv</namespace>
      <topic>thrusters/right/thrust</topic>
      <joint_name>right_prop_joint</joint_name>
      <thrust_coefficient>0.004422</thrust_coefficient>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.09</propeller_diameter>
      <velocity_control>true</velocity_control>
      <max_thrust_cmd>50</max_thrust_cmd>
      <min_thrust_cmd>-40</min_thrust_cmd>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>right_steer_joint</joint_name>
      <topic>/asv/thrusters/right/pos</topic>
      <use_velocity_commands>true</use_velocity_commands>
      <cmd_max>2</cmd_max>
      <cmd_min>-2</cmd_min>
    </plugin>
    <!-- ground truth for evaluating SLAM: topic only, NOT TF -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <dimensions>3</dimensions>
      <odom_publish_frequency>50</odom_publish_frequency>
      <odom_topic>/asv/ground_truth/odom</odom_topic>
      <tf_topic>/asv/ground_truth/pose_v</tf_topic>
    </plugin>
  </model>
</sdf>
