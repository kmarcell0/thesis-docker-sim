<?xml version="1.0"?>
<sdf version="1.9">
  <world name="course">

    <physics name="4ms" type="dart">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <scene>
      <sky></sky>
      <grid>false</grid>
      <ambient>1.0 1.0 1.0</ambient>
      <background>0.8 0.8 0.8</background>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <include>
      <name>water</name>
      <pose>0 0 0 0 0 0</pose>
      <uri>model://coast_waves</uri>
    </include>

    <plugin filename="libPublisherPlugin.so" name="vrx::PublisherPlugin">
      <message type="gz.msgs.Param" topic="/vrx/wavefield/parameters" every="2.0">
        params { key: "direction" value { type: DOUBLE double_value: 0.0 } }
        params { key: "gain"      value { type: DOUBLE double_value: 0.4 } }
        params { key: "period"    value { type: DOUBLE double_value: 5.0 } }
        params { key: "steepness" value { type: DOUBLE double_value: 0.0 } }
      </message>
    </plugin>

    <include><name>gate1_black</name>   <pose>10 -6 0 0 0 0</pose><uri>model://rb_ball_black</uri></include>
    <include><name>gate1_red</name>     <pose>10 -4 0 0 0 0</pose><uri>model://rb_marker_red</uri></include>
    <include><name>gate2_black</name>   <pose>10 -2 0 0 0 0</pose><uri>model://rb_ball_black</uri></include>
    <include><name>gate1_green</name>   <pose>10  0 0 0 0 0</pose><uri>model://rb_marker_green</uri></include>
    <include><name>gate3_black</name>   <pose>10  2 0 0 0 0</pose><uri>model://rb_ball_black</uri></include>
    <include><name>gate1_yellow</name>  <pose>10  4 0 0 0 0</pose><uri>model://rb_ball_yellow</uri></include>
    <include><name>gate4_black</name>   <pose>10  6 0 0 0 0</pose><uri>model://rb_ball_black</uri></include>

    <include><name>short_navigation_course_1</name>   <pose>10  30 -10 0 0 0</pose><uri>model://short_navigation_course_0</uri></include>


  </world>
</sdf>
