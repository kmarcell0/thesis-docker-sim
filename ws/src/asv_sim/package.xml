<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>asv_sim</name>
  <version>0.1.0</version>
  <description>RoboBoat ASV simulation: Gazebo models, worlds, bridge config and launch</description>

  <maintainer email="kovacs.marcell@edu.bme.hu">Marcell Kovács</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ROS-free maths shared with the filter (M2.1): angle helpers, geodesy -->
  <depend>asv_core</depend>
  <!-- waypoint_follower node (M1.3) -->
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <!-- teleop node (M1.8, T1 a): reads asv.yaml and teleop.yaml itself -->
  <depend>ament_index_cpp</depend>
  <depend>yaml_cpp_vendor</depend>

  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
