<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>asv_msgs</name>
  <version>0.1.0</version>
  <description>Message types of the RoboBoat ASV: buoy detections, landmarks, GNSS heading and GNSS status (M2.4)</description>

  <maintainer email="kovacs.marcell@edu.bme.hu">Marcell Kovács</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <!-- Turns the .msg files into C++ and Python types (rosidl) -->
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <!-- std_msgs/Header (stamp and frame_id) -->
  <depend>std_msgs</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
